generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  firstNameNorm String
  lastNameNorm  String
  department    String?
  elo           Int       @default(1000)
  wins          Int       @default(0)
  losses        Int       @default(0)
  streak        Int       @default(0)
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  matchesA        Match[]       @relation("PlayerA")
  matchesB        Match[]       @relation("PlayerB")
  reportedMatches Match[]       @relation("ReportedBy")
  wonMatches      Match[]       @relation("Winner")
  ratingEvents    RatingEvent[]

  @@unique([firstNameNorm, lastNameNorm])
}

model Match {
  id                 String    @id @default(cuid())
  playerAId          String
  playerBId          String
  reportedByPlayerId String?
  winnerId           String?
  status             String    @default("PENDING")
  gamesJson          String
  playedAt           DateTime  @default(now())
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())

  playerA      Player        @relation("PlayerA", fields: [playerAId], references: [id])
  playerB      Player        @relation("PlayerB", fields: [playerBId], references: [id])
  reportedBy   Player?       @relation("ReportedBy", fields: [reportedByPlayerId], references: [id])
  winner       Player?       @relation("Winner", fields: [winnerId], references: [id])
  ratingEvents RatingEvent[]
}

model RatingEvent {
  id        String @id @default(cuid())
  matchId   String
  playerId  String
  eloBefore Int
  eloAfter  Int

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])
}

model Settings {
  id               String    @id
  eventName        String
  registrationOpen Boolean   @default(true)
  startDate        DateTime?
  endDate          DateTime?
}
